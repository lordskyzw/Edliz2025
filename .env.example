# --- CAIMEX, the internal OpenAI-compatible gateway -------------------------
# Reach it directly. Do not send it through the corporate proxy: the macOS
# bypass list names econetai.local but not econetai.co.zw, so a proxied
# request to this host fails or times out. The client sets trust_env=False.
CAIMEX_BASE_URL=https://caimex.econetai.co.zw:2052/v1
CAIMEX_API_KEY=sk-or-...

# Models. deepseek-v4-flash was the fastest model on this gateway that
# actually returned tool_calls; bge-m3 is a 1024-dim multilingual embedder
# that handled clinical text well.
EDLIZ_CHAT_MODEL=deepseek-v4-flash
EDLIZ_EMBED_MODEL=bge-m3
EDLIZ_RERANK_MODEL=bge-reranker-v2-m3

# --- Corpus -----------------------------------------------------------------
# The edition answers are drawn from. Re-ingest to change it.
EDLIZ_EDITION=8th edition (2020)
EDLIZ_DB=data/edliz.db
EDLIZ_TEXT_DIR=data/text/edliz-2020

# --- Web search -------------------------------------------------------------
# lite.duckduckgo.com needs no key. Set to 0 to make the assistant
# answer from the EDLIZ corpus alone (stricter, offline-safe).
EDLIZ_WEB_SEARCH=1
EDLIZ_MAX_WEB_RESULTS=5
